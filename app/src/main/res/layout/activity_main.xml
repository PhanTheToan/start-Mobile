<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            tools:ignore="MissingConstraints"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="186dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="99dp"
            android:layout_marginTop="16dp"
            android:background="#CDE2E2E2"
            android:fontFamily="sans-serif"
            android:text="0"
            android:textAlignment="viewEnd"
            android:textSize="48sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="638dp">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="574dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <TableRow
                android:id="@+id/tablerow1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <Button
                    android:id="@+id/ce"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_clear_entry" />

                <Button
                    android:id="@+id/c"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_clear" />

                <Button
                    android:id="@+id/bs"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_backspace" />

                <Button
                    android:id="@+id/divide"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_divide" />

            </TableRow>

            <TableRow
                android:id="@+id/tablerow2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <Button
                    android:id="@+id/seven"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_7" />

                <Button
                    android:id="@+id/eight"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_8" />

                <Button
                    android:id="@+id/nice"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_9" />

                <Button
                    android:id="@+id/multiply"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_multiply" />
            </TableRow>

            <TableRow
                android:id="@+id/tablerow3"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <Button
                    android:id="@+id/four"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_4" />

                <Button
                    android:id="@+id/five"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_5" />

                <Button
                    android:id="@+id/six"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_6" />

                <Button
                    android:id="@+id/subtract"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_subtract" />
            </TableRow>

            <TableRow
                android:id="@+id/tablerow4"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <Button
                    android:id="@+id/one"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_1" />

                <Button
                    android:id="@+id/tow"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_2" />

                <Button
                    android:id="@+id/three"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_3" />

                <Button
                    android:id="@+id/add"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_add" />
            </TableRow>

            <TableRow
                android:id="@+id/tablerow5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <Button
                    android:id="@+id/pos"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_positive_negative" />

                <Button
                    android:id="@+id/zero"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EBEBEB"
                    android:text="@string/btn_0" />

                <Button
                    android:id="@+id/dot"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_decimal_point" />

                <Button
                    android:id="@+id/equal"
                    style="@style/CalculatorButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#D5D5D5"
                    android:text="@string/btn_equals" />
            </TableRow>

        </TableLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>